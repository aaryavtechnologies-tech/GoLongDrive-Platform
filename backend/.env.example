# ─────────────────────────────────────────────
#  Client Apps Configuration Guide
# ─────────────────────────────────────────────
# 📱 User App (Flutter)
# Configured in: user-app/lib/core/config/env_config.dart
# Set `apiUrl` and `socketUrl` to match this backend.
#
# 🚕 Driver App (Flutter)
# Configured in: driver-app/lib/core/config/env_config.dart
# Set `apiUrl` and `socketUrl` to match this backend.
#
# 💻 Admin Panel (Next.js)
# Configured in: admin-panel/.env
# Set NEXT_PUBLIC_API_URL=http://localhost:5051/api/v1

# ─────────────────────────────────────────────
#  Server
# ─────────────────────────────────────────────
PORT=5051
NODE_ENV=development

# ─────────────────────────────────────────────
#  MongoDB
# ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/taxi-booking

# ─────────────────────────────────────────────
#  JWT
# ─────────────────────────────────────────────
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_REFRESH_SECRET=change_this_to_another_strong_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─────────────────────────────────────────────
#  Email (Nodemailer / Gmail SMTP)
# ─────────────────────────────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Long Distance Taxi <your_email@gmail.com>"

# ─────────────────────────────────────────────
#  CORS / Client URLs
# ─────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# ─────────────────────────────────────────────
#  Google Maps
# ─────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
